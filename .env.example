# Required — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default agent model (OpenRouter id: provider/model). Used for all agent turns until TUI model picker ships.
ORIN_MODEL=anthropic/claude-sonnet-4.6

# Cheap model for delegate_read (default: deepseek/deepseek-v4-flash)
# ORIN_CHEAP_MODEL=deepseek/deepseek-v4-flash

# Approval: normal | auto-accept | plan (plan blocks write/edit/bash)
# ORIN_APPROVAL_MODE=normal

# --- LLM providers (issue #12) -------------------------------------------------
# The active provider is chosen at runtime with `/providers` and persisted to
# ~/.orin/config.json under `provider.active`. Per-provider credentials live in
# the same file (e.g. provider.openrouter.apiKey). Env vars OVERRIDE the config
# file so CI/CD keeps working without editing it.
#
# OpenRouter is the default backend (set OPENROUTER_API_KEY above).
# Regolo AI — EU-hosted OpenAI-compatible inference (https://regolo.ai):
REGOLO_API_KEY=
#
# Anthropic — native Messages API (Console API key or OAuth subscription):
ANTHROPIC_API_KEY=
#
# Additional backends land in follow-up PRs; their env vars (planned) will be:
#   OPENAI_API_KEY=        # OpenAI API key / OAuth
# Proxy/gateway providers read a base URL from config (provider.litellm.baseUrl, etc.).

# E2B cloud sandbox (optional — set sandbox.active to e2b in ~/.orin/config.json)
# E2B_API_KEY=

# --- Telemetry -----------------------------------------------------------------
# Local cost/token metrics are on by default (~/.orin/metrics.jsonl). Opt out:
# ORIN_NO_TELEMETRY=1
# Echo each metric event to stdout (debugging):
# ORIN_TELEMETRY_STDOUT=1
#
# OpenTelemetry OTLP trace export (off until an endpoint is set; the OTel SDK is
# lazy-loaded only when enabled). Standard OTEL_* env vars win over config, and
# setting the endpoint auto-enables export. ORIN_NO_TELEMETRY does NOT gate OTLP.
# Example (Langfuse):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 pk:sk>
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=orin
# OTEL_TRACES_SAMPLER=traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
