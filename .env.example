# Required — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default agent model (OpenRouter id: provider/model). Used for all agent turns until TUI model picker ships.
MINICODER_MODEL=anthropic/claude-sonnet-4

# Cheap model for delegate_read (default: deepseek/deepseek-v4-flash)
# MINICODER_CHEAP_MODEL=deepseek/deepseek-v4-flash

# Approval: normal | auto-accept | plan (plan blocks write/edit/bash)
# MINICODER_APPROVAL_MODE=normal
